{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "metacubexd",
  "version": "1.247.0",
  "identifier": "dev.pages.metacubexd",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "windows": [
      {
        "title": "MetaCubeXD",
        "width": 1200,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ]
  }
}
