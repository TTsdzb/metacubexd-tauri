{
  "name": "@metacubexd/tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "android:build": "node build-shim.mjs && node run-tauri.mjs android build --apk --ci",
    "android:dev": "node build-shim.mjs && node run-tauri.mjs android dev",
    "android:init": "node run-tauri.mjs android init --ci --skip-targets-install",
    "build": "node build-shim.mjs && node run-tauri.mjs build",
    "build:shim": "node build-shim.mjs",
    "dev": "node build-shim.mjs && node run-tauri.mjs dev",
    "tauri": "node run-tauri.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-http": "catalog:",
    "@tauri-apps/plugin-websocket": "catalog:"
  },
  "devDependencies": {
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
